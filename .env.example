# Officeverse — production environment (Phase 21).
# Copy to `.env` and fill real values. `.env` is git-ignored — NEVER commit it.
# Variable NAMES only here; all values are placeholders / non-secret identifiers.

# ── Database — GoDaddy cPanel MySQL/MariaDB ──────────────────────────────
# Preferred: one connection string.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# Fallback: discrete vars (used only when DATABASE_URL is unset).
DB_HOST=
DB_PORT=3306
DB_NAME=Officeverse
DB_USER=TMI_officeverse
DB_PASSWORD=
DB_POOL_LIMIT=10

# ── Authentication (Phase 14) ───────────────────────────────────────────
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=ov_session

# ── Internal scheduler + email worker (Phase 4 & 6) ─────────────────────
# Long random string. POST /internal/tick and /internal/drain-email require it.
CRON_SECRET=

# ── Transactional email — Resend (Phase 6) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=

# ── Application ────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Business timezone. Code is IST-explicit; this is belt-and-suspenders.
TZ=Asia/Kolkata
NODE_ENV=development

# ── Profile photo storage (Phase 15) ──────────────────────────────────
# local | s3 | r2 | supabase
PHOTO_STORAGE=local
PHOTO_LOCAL_DIR=./storage/photos
PHOTO_PUBLIC_BASE=/media/photos
PHOTO_MAX_BYTES=2097152

# ── Import file storage (Phase 8) ─────────────────────────────────────
IMPORT_UPLOAD_DIR=./storage/imports
IMPORT_MAX_BYTES=26214400

# ── Optional: error reporting ────────────────────────────────────────
SENTRY_DSN=
