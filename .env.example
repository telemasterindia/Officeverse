# Officeverse — production environment template.
# Copy to `.env` and fill real values. `.env` is git-ignored — NEVER commit it.
# Variable NAMES + non-secret identifiers only here; every value is a placeholder.

# ── Runtime / build ───────────────────────────────────────────────────
NODE_ENV=production
# Business timezone. The code is IST-explicit; this is belt-and-suspenders.
TZ=Asia/Kolkata
APP_URL=https://your-officeverse-domain
# GoDaddy / cPanel needs a Node server build, NOT the default Cloudflare preset.
# Pass this at BUILD time:  NITRO_PRESET=node-server npm run build
NITRO_PRESET=node-server
#
# PRODUCTION BOOT GUARD (src/server/config/production-guard.ts): when
# NODE_ENV=production the server refuses the first request and serves a 500
# until the MANDATORY config below is present — APP_URL (a real https origin,
# not localhost), the database connection (DATABASE_URL or DB_HOST+DB_NAME+
# DB_USER), and a cron secret (CRON_SECRET / OFFICEVERSE_CRON_SECRET). The
# error names the missing VARIABLES only — never a value. Development and the
# local dryrun DB are unaffected (the guard is a no-op unless NODE_ENV=production).
# GET /api/health also reports `config: "ok" | "incomplete"` plus advisory
# warnings (e.g. TRUSTED_PROXY_IPS unset).

# ── Scoring Engine (Phase 2 — open-ended, Admin-configurable scoring) ─
# OFF by default and NOT mandatory: an unset value reads as OFF. When OFF,
# ingest() returns before evaluating a rule or writing a row, so existing
# gamification / leaderboard behaviour is unchanged. No CRM service emits a
# BusinessEvent yet (that is Phase 4). Flip to `true` only on the dryrun DB
# once Admin rules exist and a dry run has been reviewed.
SCORING_ENGINE_ENABLED=false

# ── Database — GoDaddy cPanel MySQL / MariaDB ─────────────────────────
# Preferred: one connection string.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# Fallback: discrete vars (used only when DATABASE_URL is unset).
# GoDaddy created: database = TMI_officeverse, user = officeverse
DB_HOST=
DB_PORT=3306
DB_NAME=TMI_officeverse
DB_USER=officeverse
DB_PASSWORD=
DB_POOL_LIMIT=10

# ── Sessions / auth ──────────────────────────────────────────────────
# Cookies are httpOnly + SameSite=Lax always; `secure` turns on when NODE_ENV=production.
SESSION_COOKIE_NAME=ov_session
SESSION_TTL_HOURS=12

# ── Trusted reverse proxies (attendance / office-IP gate — audit C-1) ─
# The client IP is taken from the SOCKET PEER. X-Forwarded-For / X-Real-IP
# are honoured ONLY when the peer is inside one of these CIDRs. Leave EMPTY
# and every request is attributed to the proxy's own IP (safe, but the
# office gate then never matches). On GoDaddy/cPanel the app sits behind a
# loopback Passenger/Apache proxy, so trust loopback:
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
# If a CDN (e.g. Cloudflare) is also in front, append its egress ranges.

# ── Server-side automation (cPanel cron) ─────────────────────────────
# Long random string. Required by /internal/* endpoints (x-cron-secret header).
# Set CRON_SECRET and OFFICEVERSE_CRON_SECRET to the SAME value.
CRON_SECRET=
OFFICEVERSE_CRON_SECRET=

# ── Transactional email — Resend (behind the EmailProvider abstraction) ─
# none | devlog | resend   (resend also needs RESEND_API_KEY, else it stays disabled)
OFFICEVERSE_EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Verified sender. OFFICEVERSE_EMAIL_FROM wins; EMAIL_FROM is the fallback.
OFFICEVERSE_EMAIL_FROM=no-reply@your-officeverse-domain
EMAIL_FROM=no-reply@your-officeverse-domain
EMAIL_REPLY_TO=

# ── Salary-slip document storage ────────────────────────────────────
# memory (dev only) | filesystem (GoDaddy production — NOT supported on
# Vercel, which has no persistent filesystem; the app refuses to start this
# provider there with a clear error rather than silently losing PDFs)
DOCUMENT_STORAGE_PROVIDER=filesystem
# Absolute path OUTSIDE the public web root on the GoDaddy host.
OFFICEVERSE_DOCUMENT_ROOT=/home/CPANEL_USER/officeverse-documents

# ── Payroll ────────────────────────────────────────────────────────
# Proration is OFF unless a denominator basis is chosen. Only CALENDAR_DAYS
# is implemented; leave unset until the business decides.
# OFFICEVERSE_PRORATION_BASIS=CALENDAR_DAYS

# ── Local development only (never set in production) ────────────────
# OFFICEVERSE_DEV_LOGIN=1
# OFFICEVERSE_DEV_PASSWORD=

# ── Profile-photo / celebration-asset storage ───────────────────────
# local (GoDaddy / local dev, files on disk) | database (durable rows in the
# existing MySQL `storage_blobs` table — see server/storage/db-blob-store.ts)
#
# On Vercel, "local" cannot work (no persistent filesystem) — the app
# AUTOMATICALLY upgrades to "database" there whenever the DB itself is
# configured (which it always is — DATABASE_URL / DB_* are required for
# everything else too), using the SAME MySQL connection already in use.
# No extra Vercel env var is required for this to happen. Set PHOTO_STORAGE=
# database / CELEBRATION_STORAGE=database explicitly only if you want
# GoDaddy to also use the database instead of local disk.
PHOTO_STORAGE=local
PHOTO_LOCAL_DIR=./storage/photos
PHOTO_PUBLIC_BASE=/media/photos
PHOTO_MAX_BYTES=5242880
# Defaults to PHOTO_STORAGE when unset.
# CELEBRATION_STORAGE=local
CELEBRATION_ASSET_DIR=./storage/celebrations
IMPORT_UPLOAD_DIR=./storage/imports
IMPORT_MAX_BYTES=26214400

# ── Optional: error reporting ─────────────────────────────────────
SENTRY_DSN=
