# Officeverse — LOCAL PRODUCTION DRY-RUN environment (Phase 18).
# Copy to `.env` for a local dry run ONLY. Never GoDaddy. Never real secrets.
# Values here are safe local placeholders.

NODE_ENV=production
TZ=Asia/Kolkata
APP_URL=http://localhost:3517
NITRO_PRESET=node-server              # build-time: NITRO_PRESET=node-server npm run build

# ── Local isolated dry-run MySQL (NOT TMI_officeverse, NOT GoDaddy) ──
# A local MySQL/MariaDB server must be running for the DB portion of the dry run.
DATABASE_URL=mysql://dryrun:dryrun@127.0.0.1:3306/TMI_officeverse_dryrun
# (or the discrete vars)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=TMI_officeverse_dryrun
DB_USER=dryrun
DB_PASSWORD=dryrun
DB_POOL_LIMIT=5

# ── Sessions ──
SESSION_COOKIE_NAME=ov_session
SESSION_TTL_HOURS=12

# ── Cron (local dry run) ──
CRON_SECRET=dryrun-cron-secret-change-me
OFFICEVERSE_CRON_SECRET=dryrun-cron-secret-change-me

# ── Email — DRY RUN ONLY, never Resend ──
OFFICEVERSE_EMAIL_PROVIDER=devlog     # in-process log; NO network, NO real send
OFFICEVERSE_EMAIL_FROM=dryrun@localhost
EMAIL_FROM=dryrun@localhost

# ── Storage — local dry-run filesystem (NOT GoDaddy) ──
DOCUMENT_STORAGE_PROVIDER=filesystem
OFFICEVERSE_DOCUMENT_ROOT=./storage/dryrun-salary-slips

# ── Payroll ──
# Leave OFFICEVERSE_PRORATION_BASIS unset — proration stays off (business rule undefined).
